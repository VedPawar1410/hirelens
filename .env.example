# Used by docker-compose.yml. Copy to .env (git-ignored) and fill in.
# Signing key for login tokens: any random string of 32+ characters.
JWT_KEY=
# Accounts created on first start (leave empty to skip). Identity requires
# upper + lower case, a digit and a symbol, e.g. Demo_Pass_1!
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
POSTGRES_PASSWORD=hirelens
