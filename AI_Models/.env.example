# LLM providers, tried in order: Groq, then Gemini. A provider without a key is skipped.
GROQ_API_KEY=            # https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash-lite

# Interview emails (optional). Gmail needs an App Password: myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
SENDER_NAME=HR Team - Acme Corp

HF_HUB_OFFLINE=1
