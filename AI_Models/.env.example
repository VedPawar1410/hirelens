# LLM provider for ATS scoring and JD generation: groq | nvidia | openrouter
DEFAULT_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional fallbacks
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_RATE_LIMIT=40
NVIDIA_RATE_LIMIT_WINDOW=60
ATS_CONCURRENCY=5

# Interview emails (Gmail needs an app password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
SENDER_NAME=HR Team - Acme Corp

HF_HUB_OFFLINE=1
